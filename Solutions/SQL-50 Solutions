1211. Queries Quality and Percentage

SELECT
    query_name,
    ROUND(AVG(rating / position), 2) AS quality,
    ROUND(
        100 * SUM(
        CASE WHEN rating < 3 THEN 1
        ELSE 0
        END) / COUNT(query_name)
        , 2) AS poor_query_percentage
FROM Queries
GROUP BY query_name;

Alternate Solution:

SELECT
	query_name,
	ROUND(AVG(rating / position), 2) AS quality,
	ROUND(AVG(rating < 3) * 100, 2) AS poor_query_percentage
FROM Queries
GROUP BY query_name;


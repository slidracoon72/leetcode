610. Triangle Judgement

SELECT x, y, z,
    CASE
        WHEN (x+y+z) - GREATEST(x,y,z) > GREATEST(x,y,z) THEN 'Yes'
        ELSE 'No'
    END
    AS triangle
FROM Triangle;

Alternate Solution:

SELECT x, y, z,
CASE
    WHEN ((y+z) <= x) THEN 'No'
    WHEN ((x+z) <= y) THEN 'No'
    WHEN ((x+y) <= z) THEN 'No'
    ELSE 'Yes'
END AS triangle
FROM Triangle;

